#!/usr/bin/env bash
set -euo pipefail

# swaymsg/i3-msg stand-in for macOS covering only the IPC subset dfzf uses (see
# README); anything else fails loudly instead of silently doing the wrong thing.

die() {
	echo "dfzf-hs-msg: $*" >&2
	exit 2
}
unsupported() { die "unsupported on macOS: $*"; }

# JSON is built with printf rather than `jq -n`: one process less per request.
json_str() {
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	s="${s//$'\t'/\\t}"
	s="${s//$'\n'/\\n}"
	printf '"%s"' "$s"
}

# shellcheck source=dfzf-hs
source "$(command -v dfzf-hs)"

msg_type="command"
words=()
while [[ $# -gt 0 ]]; do
	case $1 in
	-t | --type)
		msg_type="$2"
		shift 2
		;;
	# Output-format flags of swaymsg/i3-msg: irrelevant here, output is
	# always the raw JSON for get_tree and nothing for commands.
	-q | --quiet | -r | --raw | -p | --pretty)
		shift
		;;
	*)
		words+=("$1")
		shift
		;;
	esac
done

# The Lua backend (hs.json) may encode an empty Lua table as an object: normalize
# the list fields so jq filters like `.marks | index(...)` behave as with sway.
# The native backend already emits lists: without any `{}`, skip the jq pass.
get_tree() {
	local tree
	tree=$(dfzf_hs '{"op":"tree"}')
	if [[ $tree != *'{}'* ]]; then
		printf '%s\n' "$tree"
		return
	fi
	jq '
	  (.. | objects | select(has("marks") and (.marks | type) != "array") | .marks) |= []
	  | (.. | objects | select(has("nodes") and (.nodes | type) != "array") | .nodes) |= []
	  | (.. | objects | select(has("floating_nodes") and (.floating_nodes | type) != "array") | .floating_nodes) |= []' <<<"$tree"
}

case "$msg_type" in
get_tree)
	get_tree
	exit 0
	;;
get_outputs)
	dfzf_hs '{"op":"outputs"}'
	exit 0
	;;
command) ;;
*) unsupported "-t $msg_type" ;;
esac

command_str="${words[*]:-}"

criteria='[]'
has_criteria=false
action="$command_str"
re_command='^[[:space:]]*\[([^]]*)\][[:space:]]*(.*)$'
if [[ $command_str =~ $re_command ]]; then
	has_criteria=true
	criteria_str="${BASH_REMATCH[1]}"
	action="${BASH_REMATCH[2]}"
	# key="value with \"escapes\"" | key=bareword
	re_pair='^[[:space:]]*([a-z_]+)=("(([^"\\]|\\.)*)"|([^[:space:]]+))(.*)$'
	while [[ -n ${criteria_str//[[:space:]]/} ]]; do
		[[ $criteria_str =~ $re_pair ]] || die "cannot parse criteria: [$criteria_str]"
		key="${BASH_REMATCH[1]}"
		if [[ ${BASH_REMATCH[2]} == \"* ]]; then
			value="${BASH_REMATCH[3]//\\\"/\"}"
		else
			value="${BASH_REMATCH[5]}"
		fi
		criteria_str="${BASH_REMATCH[6]}"
		case "$key" in
		con_id | app_id | class | title | con_mark) ;;
		*) unsupported "criteria key '$key'" ;;
		esac
		pair="[$(json_str "$key"),$(json_str "$value")]"
		if [[ $criteria == '[]' ]]; then
			criteria="[$pair]"
		else
			criteria="${criteria%]},$pair]"
		fi
	done
fi

# Trim surrounding whitespace.
action="${action#"${action%%[![:space:]]*}"}"
action="${action%"${action##*[![:space:]]}"}"

if [[ $action == exec\ * ]]; then
	cmd="${action#exec }"
	cmd="${cmd#--no-startup-id }"
	# Detach like sway's exec: the caller (often a short-lived popup) must not
	# take the launched program down with it.
	# nohup without its two execs (nohup itself, then /bin/sh re-executing bash).
	(
		trap '' HUP
		exec /bin/bash -c "$cmd"
	) </dev/null >/dev/null 2>&1 &
	exit 0
fi

# The one chain in scope (scratchpad creation) collapses to its visible end
# state; other chains belong to features out of the macOS scope.
[[ $action == "move scratchpad, scratchpad show" ]] && action="scratchpad show"
[[ $action == *,* ]] && unsupported "command chain '$action'"

# Without criteria, sway applies the command to the focused window; the one
# exception is a bare `unmark`, which targets every window.
read -r verb rest <<<"$action"
# No-op: windows are either maximized or dfzf popups sized by the spoon.
[[ $verb == floating ]] && exit 0
if [[ $has_criteria == false && $verb != unmark ]]; then
	criteria='[["con_id","__focused__"]]'
	has_criteria=true
fi

select_ids() {
	get_tree | jq -c --argjson crit "$criteria" '
	  [ .. | objects | select(.type == "con") | . as $w
	    | select(all($crit[]; . as [$k, $v]
	        | if $k == "con_id" then
	            (if $v == "__focused__" then $w.focused == true else ($w.id | tostring) == $v end)
	          elif $k == "app_id" or $k == "class" then ($w.app_id // "") | test($v)
	          elif $k == "title" then ($w.name // "") | test($v)
	          elif $k == "con_mark" then any(($w.marks // [])[]; test($v))
	          else false end))
	    | .id ]'
}

ids='null'
re_single_id='^\[\["con_id","([0-9]+)"\]\]$'
single_id=""
[[ $criteria =~ $re_single_id ]] && single_id="${BASH_REMATCH[1]}"
if [[ $has_criteria == true && -n $single_id && $verb =~ ^(mark|unmark|kill|focus|scratchpad|move|resize)$ ]]; then
	# A bare con_id needs no tree lookup: an unknown id is harmless for
	# mark/unmark/kill, and an error from the backend for the single-window
	# actions, which keeps the `focus || fallback` chains working.
	ids="[$single_id]"
elif [[ $has_criteria == true ]]; then
	ids=$(select_ids)
	# Mirror sway: a command whose criteria match nothing is an error, which
	# callers use for fallbacks (`... focus || ...`).
	[[ $ids == '[]' ]] && die "No matching node"
fi

# Last matched id: sway applies the command to each match in turn, so the last
# one wins for single-window actions.
last_id="${ids#[}"
last_id="${last_id%]}"
last_id="${last_id##*,}"

call() { dfzf_hs "$1" >/dev/null; }

case "$verb" in
focus)
	[[ -z $rest ]] || unsupported "focus $rest"
	call "{\"op\":\"focus\",\"id\":$last_id}"
	;;
kill)
	call "{\"op\":\"close\",\"ids\":$ids}"
	;;
scratchpad)
	[[ $rest == show ]] || unsupported "scratchpad $rest"
	call "{\"op\":\"show\",\"id\":$last_id}"
	;;
move)
	re_position='^position ([0-9]+)(px)? ([0-9]+)(px)?$'
	if [[ $rest == scratchpad ]]; then
		call "{\"op\":\"hide\",\"ids\":$ids}"
	elif [[ $rest =~ $re_position ]]; then
		call "{\"op\":\"move\",\"id\":$last_id,\"x\":$((10#${BASH_REMATCH[1]})),\"y\":$((10#${BASH_REMATCH[3]}))}"
	else
		unsupported "move $rest"
	fi
	;;
resize)
	re_size='^set ([0-9]+)(px)? ([0-9]+)(px)?$'
	[[ $rest =~ $re_size ]] || unsupported "resize $rest"
	call "{\"op\":\"resize\",\"id\":$last_id,\"w\":$((10#${BASH_REMATCH[1]})),\"h\":$((10#${BASH_REMATCH[3]}))}"
	;;
urgent)
	case "$rest" in
	enable | disable | toggle) ;;
	*) unsupported "urgent $rest" ;;
	esac
	call "{\"op\":\"urgent\",\"ids\":$ids,\"mode\":\"$rest\"}"
	;;
mark)
	add=false
	if [[ $rest == --add\ * ]]; then
		add=true
		rest="${rest#--add }"
	fi
	[[ -n $rest && $rest != -* && $rest != *\ * ]] || unsupported "mark $rest"
	call "{\"op\":\"mark\",\"id\":$last_id,\"mark\":$(json_str "$rest"),\"add\":$add}"
	;;
unmark)
	[[ $rest != *\ * ]] || unsupported "unmark $rest"
	if [[ $ids == null ]]; then
		call "{\"op\":\"unmark\",\"mark\":$(json_str "$rest")}"
	else
		call "{\"op\":\"unmark\",\"mark\":$(json_str "$rest"),\"ids\":$ids}"
	fi
	;;
*)
	unsupported "'$action'"
	;;
esac
