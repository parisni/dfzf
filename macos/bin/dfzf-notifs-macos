#!/usr/bin/env bash
set -euo pipefail

# Notification Center browser for macOS, through the `notif` CLI (Accessibility
# API). Lists what Notification Center shows: macOS keeps no notification history.

if ! command -v notif >/dev/null; then
	echo "dfzf-notifs: notif not found (brew install coryfklein/tap/notif)" >&2
	exit 1
fi

# macOS stacks an app's notifications into a collapsed group that only exposes
# its latest one: expand every group so each notification gets its own line.
# Expanding keeps top-level indexes, so one listing gives them all.
expand_groups() {
	local index
	for index in $(notif list | perl -ne 'print "$1\n" if /^\[([0-9]+)\] .* \(group, collapsed\)$/'); do
		notif expand "$index" >/dev/null
	done
}

# One "<index>\t<text>" line per notification. notif prints bodies verbatim, so
# a line without an "[index]" prefix continues a multi-line body of the previous
# entry. Expanded group headers are dropped: their notifications follow them.
list() {
	expand_groups
	notif list | perl -ne '
		chomp;
		if (/^\[[0-9]+\] .* \([0-9]+ notifications, expanded\)$/) { $skip = 1 }
		elsif (/^\s*\[([0-9.]+)\] (.*)$/) { $skip = 0; print "\n" if $count++; print "$1\t$2" }
		elsif (!$skip && $count && /\S/) { s/^\s+//; print " $_" }
		END { print "\n" if $count }'
}

# notif indexes are screen positions that shift as notifications come and go:
# re-resolve the picked text against a fresh listing instead of trusting them.
resolve() {
	list | perl -sne '
		chomp;
		my ($index, $text) = split /\t/, $_, 2;
		next unless $text eq $picked_text;
		$hit //= $index;
		if ($index eq $picked_index) { $hit = $index; last }
		END { if (defined $hit) { print "$hit\n" } else { $? = 1 } }
	' -- -picked_index="$1" -picked_text="$2"
}

case "${1:-}" in
--list)
	list
	exit 0
	;;
--click)
	picked="${2:?usage: dfzf-notifs-macos $1 <listed line>}"
	if ! index="$(resolve "${picked%%$'\t'*}" "${picked#*$'\t'}")"; then
		echo "dfzf-notifs: notification gone: ${picked#*$'\t'}" >&2
		exit 1
	fi
	notif click "$index" >/dev/null
	exit 0
	;;
# Several picks are dismissed last first: dismissing one shifts the indexes of
# those listed after it, so the remaining picks keep theirs.
--dismiss)
	shift
	: "${1:?usage: dfzf-notifs-macos --dismiss <listed line>...}"
	status=0
	for ((pick = $#; pick >= 1; pick--)); do
		picked="${!pick}"
		if index="$(resolve "${picked%%$'\t'*}" "${picked#*$'\t'}")"; then
			notif dismiss "$index" >/dev/null
		else
			echo "dfzf-notifs: notification gone: ${picked#*$'\t'}" >&2
			status=1
		fi
	done
	exit "$status"
	;;
esac

export SHELL="$(command -v bash)"
export FZF_DEFAULT_OPTS="--ansi --no-sort --exact --cycle --color=gutter:-1 --header= --info=inline-right ${DFZF_FZF_OPTS-"--padding=1,2 --border=rounded --color=border:#ff8800"}"

[[ -e ${XDG_RUNTIME_DIR:-/tmp}/dfzf-help.notifs ]] && dfzf-help reset notifs
picked=$(list | fzf --prompt "Notifs > " --multi --delimiter $'\t' --with-nth 2 \
	--preview 'printf "%s\n" {2}' \
	--preview-window=up:30%:wrap \
	--bind="?:transform-header(dfzf-help toggle notifs)" \
	--bind "enter:deselect-all+accept" \
	--bind "ctrl-k:execute-silent(dfzf-notifs-macos --dismiss {})+reload(dfzf-notifs-macos --list)" \
	--bind "alt-K:select-all+execute-silent(dfzf-notifs-macos --dismiss {+})+deselect-all+reload(dfzf-notifs-macos --list)" \
	--bind "ctrl-h:change-header(No notification history on macOS)") || exit 0
# Clicking runs the notification's own action, which brings its app forward.
dfzf-notifs-macos --click "$picked"
