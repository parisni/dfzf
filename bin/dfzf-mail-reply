#!/usr/bin/env bash
set -euo pipefail

# Spawned in its own kitty window by `dfzf-mail` (ctrl-r / ctrl-alt-r) so that
# $EDITOR runs in a regular tiled terminal, not in the dfzf-popup floating
# kitty (which has `map escape close_window` and a 65% size, both unsuitable
# for composing a reply).
#
# Usage: dfzf-mail-reply <mailbox> <id> [--all]
#
# himalaya v2 dropped the editor-driven composer: himalaya only fetches the
# source message, `dfzf-mail-compose` owns the template + $EDITOR + send loop.

mailbox="${1:?missing mailbox}"
id="${2:?missing id}"
shift 2

source_eml="$(mktemp -t dfzf-mail-source-XXXXXX.eml)"
trap 'rm -f "$source_eml"' EXIT

himalaya --log off message read -m "$mailbox" --raw "$id" >"$source_eml"
dfzf-mail-compose reply "$@" -- "$source_eml"
