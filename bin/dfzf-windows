#!/usr/bin/env bash
set -euo pipefail

export SHELL="$(command -v bash)"
export FZF_DEFAULT_OPTS="--ansi --no-sort --exact --cycle --color=gutter:-1 --header= --info=inline-right ${DFZF_FZF_OPTS-"--padding=1,2 --border=rounded --color=border:#ff8800"}"
windows_prompt_pattern="^[>$%] "
windows_app_filter="${DFZF_WINDOWS_APP_FILTER-}"
# When set, skip the "start:up" bind that preselects the most recently focused
# window (the Alt-Tab back-and-forth behaviour); the cursor then stays on the
# first listed item instead.
no_first_item=false
# --kitty-companions lists kittyx companion shells too; opt-in because each
# listing then queries kitty (~0.1s), exported so fzf reloads inherit it.
kitty_companions=false
# --show-hidden includes dfzf-hidden windows for this session only. Exported so
# the in-fzf reload(dfzf-windows-load) binds inherit it (no /tmp state change).
show_hidden=false
# --persistent (macOS, native backend): the Dfzf.spoon windows switcher. fzf
# outlives each use in its own hidden kitty instance: the spoon reloads the list
# and shows it through fzf --listen, closing becomes hiding. Needs FZF_API_KEY
# and DFZF_SWITCHER_PORT_FILE, where the port is published once ready.
persistent=false

while [[ $# -gt 0 ]]; do
	case $1 in
	--app)
		windows_app_filter="$2"
		shift 2
		;;
	--no-first-item)
		no_first_item=true
		shift
		;;
	--show-hidden)
		show_hidden=true
		shift
		;;
	--kitty-companions)
		kitty_companions=true
		shift
		;;
	--persistent)
		persistent=true
		shift
		;;
	*)
		shift
		;;
	esac
done

export DFZF_WINDOWS_APP_FILTER="$windows_app_filter"
export DFZF_WINDOWS_SHOW_HIDDEN="$show_hidden"
export DFZF_WINDOWS_KITTY_COMPANIONS="$kitty_companions"
[ -f "$HOME/.config/dfzf/dfzf.conf" ] && source "$HOME/.config/dfzf/dfzf.conf"

extract_con_id() {
	# perl rather than `sed -z`: BSD sed (macOS) has no NUL-separated mode.
	perl -0777 -pe 's/.*#([0-9]+).*/$1/s'
}
toggle_color() {
	color="$1"
	state_base="/tmp/dfzf-windows-color-"
	state_file="${state_base}${color}"
	if [[ -f $state_file ]]; then
		# File exists → de-toggle: remove the file
		rm -f "$state_file"
	else
		findcommand=$(command -v fd || command -v fdfind) || {
			echo "Neither fd nor fdfind found"
			exit 1
		}
		$findcommand 'dfzf-windows-color-.+' /tmp | xargs rm -f || true
		touch "$state_file"
	fi
	dfzf-windows-load
}
toggle_hidden() {
	state_file="/tmp/dfzf-windows-show-hidden"
	if [[ -f $state_file ]]; then
		# File exists → de-toggle: remove the file
		rm -f "$state_file"
	else
		touch "$state_file"
	fi
	dfzf-windows-load
}
export -f extract_con_id
export -f toggle_color
export -f toggle_hidden
set_prompt() {
	PROMPT="Windows > "
	if [[ -n $windows_app_filter ]]; then
		PROMPT="Windows [$windows_app_filter] > "
	fi
	for code in 31 32 34; do
		if [[ -f "/tmp/dfzf-windows-color-$code" ]]; then
			case "$code" in
			31) PROMPT=$'\033[31m '"$PROMPT"$' \033[0m' ;; # red prompt
			32) PROMPT=$'\033[32m '"$PROMPT"$' \033[0m' ;; # green prompt
			34) PROMPT=$'\033[34m '"$PROMPT"$' \033[0m' ;; # blue prompt
			esac
			break
		fi
	done
}
set_prompt

PREVIEW='echo {}'
PREVIEW_WINDOW='up:3,wrap'

start_binds=(--bind "change:first")
if [[ $persistent == true ]]; then
	if [[ -z ${FZF_API_KEY:-} || -z ${DFZF_SWITCHER_PORT_FILE:-} || -z ${KITTY_PID:-} ]]; then
		echo "dfzf-windows --persistent: FZF_API_KEY, DFZF_SWITCHER_PORT_FILE and KITTY_PID are required" >&2
		exit 2
	fi
	# shellcheck source=../macos/bin/dfzf-hs
	source "$(command -v dfzf-hs)"
	hide_switcher() { dfzf_hs "{\"op\":\"hideApp\",\"pid\":$KITTY_PID}" >/dev/null; }
	publish_port() {
		printf '%s' "$FZF_PORT" >"$DFZF_SWITCHER_PORT_FILE.tmp"
		mv "$DFZF_SWITCHER_PORT_FILE.tmp" "$DFZF_SWITCHER_PORT_FILE"
	}
	export -f dfzf_hs hide_switcher publish_port
	# Closing hides: the selection, query and list are reset for the next use,
	# whose reload rebinds `load` to preselect the previous window once.
	close_action="execute-silent(hide_switcher)+deselect-all+clear-query+reload(true)"
	self_app_id="dfzf-switcher"
	if [[ $no_first_item == false ]]; then
		start_binds+=(--bind "load:pos(2)+unbind(load)")
	else
		start_binds+=(--bind "load:unbind(load)")
	fi
	start_binds+=(--listen --bind "start:execute-silent(hide_switcher; publish_port)"
		--bind "ctrl-c:$close_action" --bind "ctrl-q:$close_action")
	enter_action="execute-silent(dfzf-windows-line focus {})+$close_action"
	# Hiding lets macOS activate any app: focus the previous window first, as
	# the popup's esc does (the switcher itself is never listed).
	esc_action='execute-silent(dfzf-windows-line focus "$(dfzf-windows-load | head -n1)")+'"$close_action"
	result=""
else
	# macOS: Dfzf.spoon already keeps a single popup, dfzf-kill-bro would only
	# relay the tree. The native backend's tree needs no normalization: read it
	# in one request, without the dfzf-exec -> dfzf-hs-msg hops (the Lua one may
	# encode empty lists as `{}`, which dfzf-hs-msg fixes).
	if [[ $OSTYPE == darwin* ]]; then
		# shellcheck source=../macos/bin/dfzf-hs
		source "$(command -v dfzf-hs)"
		current_tree=$(dfzf_hs '{"op":"tree"}')
		[[ $current_tree != *'{}'* ]] || current_tree=$(dfzf-hs-msg -t get_tree)
	else
		current_tree=$(dfzf-kill-bro)
	fi
	close_action="abort"
	self_app_id="dfzf-popup"
	if [[ $no_first_item == false ]]; then
		start_binds=(--bind "start:up" "${start_binds[@]}")
	fi
	enter_action="execute-silent(dfzf-windows-line focus {})+accept"
	esc_action='execute-silent(dfzf-windows-line focus "$(dfzf-windows-load | head -n1)")+abort'
	# Pipe the tree instead of passing it as an argument: a large tree (many
	# windows with long titles) overflows MAX_ARG_STRLEN and aborts with
	# "Argument list too long".
	result=$(printf '%s' "$current_tree" | dfzf-windows-load --input-json -)

	# Check if result is empty and provide a working fzf with no entries
	if [[ -z $result ]]; then
		echo "No windows found" | fzf --sync --prompt "$PROMPT" \
			--preview='echo "No windows available"' \
			--preview-window="up:3,wrap" \
			--bind="enter:abort" \
			--bind="esc:abort"
		exit 0
	fi

	# macOS has no floating windows: skip a round-trip to the backend on every launch.
	if [[ $OSTYPE != darwin* ]]; then
		dfzf-exec -q '[con_id='"$(head -n1 <<<"$result" | extract_con_id)"']' floating disable
	fi
fi

# Start with the keybinding cheatsheet hidden each session (`?` toggles it).
if [[ -e ${XDG_RUNTIME_DIR:-/tmp}/dfzf-help.windows ]]; then
	dfzf-help reset windows
fi

fzf --sync --multi --prompt "$PROMPT" \
	"${start_binds[@]}" \
	--bind="?:transform-header(dfzf-help toggle windows)" \
	--preview="$PREVIEW" \
	--preview-window="$PREVIEW_WINDOW" \
	--bind "ctrl-t:execute-silent(echo {+} |rg -o '#\d+\b' | rg -o '\d+' | paste -sd ' ' - | xargs dfzf-windows-till)+$close_action" \
	--bind="ctrl-r:execute-silent(echo {} |extract_con_id| xargs -I @ dfzf-mark --con-id @ --mark _dfzf-red --append-ts)+reload(dfzf-windows-load)" \
	--bind="ctrl-b:execute-silent(echo {} |extract_con_id| xargs -I @ dfzf-mark --con-id @ --mark _dfzf-blue --append-ts)+reload(dfzf-windows-load)" \
	--bind="ctrl-g:execute-silent(echo {} |extract_con_id| xargs -I @ dfzf-mark --con-id @ --mark _dfzf-green --append-ts)+reload(dfzf-windows-load)" \
	--bind="ctrl-o:execute-silent(echo {} |extract_con_id| xargs -I @ dfzf-mark --con-id @ --mark _dfzf-orange --append-ts)+reload(dfzf-windows-load)" \
	--bind $'B:reload(toggle_color 34)+change-prompt(\033[34m Windows > \033[0m)' \
	--bind $'R:reload(toggle_color 31)+change-prompt(\033[31m Windows > \033[0m)' \
	--bind $'G:reload(toggle_color 32)+change-prompt(\033[32m Windows > \033[0m)' \
	--bind="ctrl-k:execute-silent(dfzf-windows-line kill {})+reload(dfzf-windows-load)" \
	--bind="ctrl-u:execute-silent(echo {} |extract_con_id| xargs -I @ dfzf-exec -q '[con_id=@] urgent toggle')+reload(dfzf-windows-load)" \
	--bind="ctrl-h:reload(toggle_hidden)" \
	--bind="ctrl-j:execute-silent(echo {} |extract_con_id| xargs -I @ sh -c \"dfzf-mark --con-id @ --mark _dfzf-preview && dfzf-exec -q '[con_id=@]' focus && dfzf-mark --con-id @ --mark _dfzf-preview && dfzf-exec -q '[app_id=\\\"^$self_app_id$\\\"]' focus || dfzf-exec -q '[class=\\\"^$self_app_id$\\\"]' focus \")" \
	--bind="enter:$enter_action" \
	--bind="esc:$esc_action" < <([[ -z $result ]] || printf '%s\n' "$result")
