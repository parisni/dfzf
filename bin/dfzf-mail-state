#!/usr/bin/env bash
set -euo pipefail

# Helper invoked from `dfzf-mail` fzf bindings to mutate the shared state
# file (folder/page/page-size/query) and to compute the dynamic prompt.
#
# Subcommands:
#   next-page     increment current page (clamped on himalaya error is left
#                 to the user: ctrl-p brings them back).
#   prev-page     decrement current page, clamped to 1.
#   pick-folder   open a nested fzf to pick a folder from `himalaya mailbox
#                 list`; resets page to 1 and clears the search query (a
#                 search is mentally tied to a folder).
#   move <id>     open the same nested fzf folder picker as `pick-folder`,
#                 then move envelope <id> from the current folder to the
#                 chosen target. Self-contained (picker + himalaya move) so
#                 it can run under fzf's `execute(... </dev/tty >/dev/tty)`,
#                 where the binding redirects stdout to the tty and a
#                 command-substitution capture would therefore be empty.
#   search        prompt for a himalaya search query, store it and reset to
#                 page 1; an empty query clears the filter.
#   toggle-att    flip the attachment-only filter and reset to page 1.
#   prompt        print the dynamic fzf prompt based on current state.
#   folder        print the currently selected folder (used by the reply
#                 binding which needs to pass `-m <mailbox>` to himalaya).

state_file="${DFZF_MAIL_STATE:-${XDG_RUNTIME_DIR:-/tmp}/dfzf-mail.state}"

folder="INBOX"
page=1
page_size=50
query=""
att=0
if [[ -r $state_file ]]; then
	# shellcheck disable=SC1090
	source "$state_file"
fi

save_state() {
	# The state file is `source`d back, and himalaya's query DSL requires
	# quotes around multi-word patterns (`subject "en cours"`); a raw
	# "query=${query}" interpolation would then break the file at re-source
	# time. `%q` emits a shell-reusable form, so any quote/space/glob in the
	# query survives the round-trip.
	{
		printf 'folder=%q\n' "$folder"
		printf 'page=%s\n' "$page"
		printf 'page_size=%s\n' "$page_size"
		printf 'query=%q\n' "$query"
		printf 'att=%s\n' "$att"
	} >"$state_file"
}

# Shared nested fzf folder picker. Prints the selected folder name (empty if
# the user aborts). Reused by `pick-folder` (changes the view) and
# `pick-move-folder` (move target), so the listing/UI stays in one place.
pick_folder() {
	himalaya --log off mailbox list --json |
		jq -r '.mailboxes[] | .name' |
		fzf --prompt "${1:-Folder > }" --no-preview --height=40% --reverse
}

case "${1:-}" in
next-page)
	page=$((page + 1))
	save_state
	;;
prev-page)
	if ((page > 1)); then
		page=$((page - 1))
	fi
	save_state
	;;
pick-folder)
	picked="$(pick_folder "Folder > ")" || exit 0
	[[ -z $picked ]] && exit 0
	folder="$picked"
	page=1
	query=""
	att=0
	save_state
	;;
move)
	id="${2:?missing envelope id}"
	target="$(pick_folder "Move to > ")" || exit 0
	[[ -z $target ]] && exit 0
	himalaya --log off message move --from "$folder" --to "$target" "$id"
	;;
search)
	# fzf with an empty list acts as a free-text input; --print-query
	# echoes whatever was typed. The header documents himalaya's query
	# syntax so the user does not have to remember it (v2 dropped the
	# `before <date>` clause; `date` and `after` remain). Multi-word
	# patterns must be quoted: `subject en cours` is a parse error. The DSL
	# has no attachment clause, so point at `alt-a` here: this prompt is
	# where one looks for it.
	header=$'Query: subject|body|from|to <txt> · date|after <yyyy-mm-dd> · flag <f> · and/or/not · order by date desc\nEx: from enedis and subject facture    |    body rdv after 2026-01-01 order by date desc\nQuote multi-word patterns: subject "en cours"    ·    Empty query clears the search.\nNo attachment clause: use alt-a to show only mails with attachments.'
	# `set -e` aborts the whole script when a command substitution exits
	# non-zero, and fzf exits 1 when Enter is pressed on an empty list. Run
	# fzf on its own line guarded by `|| rc=$?` so the typed query survives;
	# only esc/ctrl-c (130) is treated as a real abort.
	rc=0
	typed="$(: | fzf --prompt "Search > " --print-query --no-preview \
		--height=40% --reverse --header="$header" --query="$query" \
		--bind="enter:print-query+accept")" || rc=$?
	[[ $rc -eq 130 ]] && exit 0
	query="$(printf '%s' "$typed" | head -n1)"
	page=1
	save_state
	;;
toggle-att)
	att=$((1 - att))
	page=1
	save_state
	;;
prompt)
	# Flags are independent: a search can be narrowed to attachments.
	flags=""
	[[ -n $query ]] && flags=" 🔍"
	((att)) && flags="$flags 📎"
	printf 'Mail [%s%s p%s] > ' "$folder" "$flags" "$page"
	;;
folder)
	printf '%s' "$folder"
	;;
*)
	echo "usage: dfzf-mail-state {next-page|prev-page|pick-folder|move <id>|search|toggle-att|prompt|folder}" >&2
	exit 2
	;;
esac
