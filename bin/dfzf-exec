#!/usr/bin/env bash
set -euo pipefail

export SHELL="$(command -v bash)"
msgcommand=""

if [ -n "${SWAYSOCK:-}" ]; then
	msgcommand="swaymsg"
elif [ -n "${I3SOCK:-}" ]; then
	msgcommand="i3-msg"
# $OSTYPE instead of uname: no extra process on the path of every dfzf command.
elif [[ $OSTYPE == darwin* ]]; then
	# Hammerspoon shim speaking the subset of the i3 IPC that dfzf uses (macos/).
	msgcommand="dfzf-hs-msg"
fi

if [ -z "$msgcommand" ]; then
	echo "No running instance of Sway, i3 or macOS (Hammerspoon) detected."
	exit 1
fi

exec "$msgcommand" "$@"
