#!/usr/bin/env bash
set -euo pipefail

# Toggle focus between a "target" window (matched by a sway/i3 criteria) and the
# window that was focused right before jumping to it.
#
# Motivation: bindings like `$mod+s` focus a fixed window (e.g. Slack). Pressing
# the binding again should bring us back to where we came from, instead of being
# a no-op once we already are on the target. The origin is remembered as a sway
# mark on the origin window itself: this mirrors how dfzf already tracks recency
# via marks, it self-clears when that window closes, and it does not survive a
# sway/i3 restart (no stale /tmp state to reason about).
#
# Usage:
#   dfzf-focus-toggle <key> <criteria> [fallback-cmd ...]
#
#   <key>          stable identifier, used to namespace the origin mark
#                  (e.g. "slack" -> mark "_dfzf-origin-slack")
#   <criteria>     sway/i3 criteria selecting the target, e.g.
#                  '[app_id="firefox" title="app.slack.com"]'
#   fallback-cmd   optional command run when the target window does not exist
#                  (e.g. open it). Everything after <criteria> is the command.
#
# Behaviour:
#   - target missing            -> run fallback-cmd (if any)
#                                  remembering the current window as origin
#   - not on target             -> mark current window as origin, focus target
#   - already on target         -> focus the origin window (back), clear mark
#   - origin lost/absent        -> focus the most recent other window instead

if [[ $# -lt 2 ]]; then
	echo "usage: dfzf-focus-toggle <key> <criteria> [fallback-cmd ...]" >&2
	exit 2
fi

key="$1"
criteria="$2"
shift 2
fallback=("$@")

origin_mark="_dfzf-origin-${key}"
probe_mark="_dfzf-focus-toggle-probe-${key}"

# dfzf-exec only picks the backend: on macOS call it directly, one bash start
# less on each of the requests below.
msg=dfzf-exec
if [[ -z ${SWAYSOCK:-} && -z ${I3SOCK:-} && $OSTYPE == darwin* ]]; then
	msg=dfzf-hs-msg
fi

# The native macOS backend runs the whole toggle in one request (focusToggle):
# no probe marks, tree or jq, one process instead of about twenty. The Lua
# backend does not know that request: fall through to the generic path below.
if [[ $msg == dfzf-hs-msg ]]; then
	# shellcheck source=../macos/bin/dfzf-hs
	source "$(command -v dfzf-hs)"
	json_escape() {
		local s="$1"
		s="${s//\\/\\\\}"
		s="${s//\"/\\\"}"
		s="${s//$'\t'/\\t}"
		s="${s//$'\n'/\\n}"
		REPLY="\"$s\""
	}
	has_fallback=false
	if [[ ${#fallback[@]} -gt 0 ]]; then
		has_fallback=true
	fi
	json_escape "$key"
	request="{\"op\":\"focusToggle\",\"key\":$REPLY"
	json_escape "$criteria"
	request+=",\"criteria\":$REPLY,\"fallback\":$has_fallback}"
	if reply="$(dfzf_hs "$request" 2>&1)"; then
		if [[ $reply == missing && $has_fallback == true ]]; then
			exec "${fallback[@]}"
		fi
		exit 0
	fi
	if [[ $reply != *"unknown request"* ]]; then
		printf '%s\n' "$reply" >&2
		exit 1
	fi
fi

# Marks are unique (sway and the macOS backend alike): marking the new origin
# moves the mark off the previous one, so an explicit unmark is only needed when
# there is no window to mark.
set_origin() {
	if [[ -n $1 ]]; then
		"$msg" -q "[con_id=$1] mark --add ${origin_mark}" >/dev/null 2>&1 || true
	else
		"$msg" -q "[con_mark=\"^${origin_mark}\$\"] unmark ${origin_mark}" >/dev/null 2>&1 || true
	fi
}

# Probe the target: tag every window matching <criteria> with a transient mark,
# read it back from the tree, then remove it. This lets us use sway's own
# criteria matching instead of re-implementing it in jq.
"$msg" -q "${criteria} mark --add ${probe_mark}" >/dev/null 2>&1 || true

tree="$("$msg" -t get_tree)"
# One jq pass: focused window, whether a target is focused, then the targets.
mapfile -t probe < <(jq -r --arg m "$probe_mark" '
	(first(.. | objects | select(.focused == true) | .id) // ""),
	([.. | objects | select((.marks // []) | index($m)) | .focused] | any),
	(.. | objects | select((.marks // []) | index($m)) | .id)' <<<"$tree")
current_id="${probe[0]-}"
target_focused="${probe[1]-false}"
matched_ids="$(printf '%s\n' "${probe[@]:2}")"

while IFS= read -r mid; do
	if [[ -n $mid ]]; then
		"$msg" -q "[con_id=${mid}] unmark ${probe_mark}" >/dev/null 2>&1 || true
	fi
done <<<"$matched_ids"

if [[ -z $matched_ids ]]; then
	# Target does not exist: the fallback creates it, so the current window is
	# the origin to come back to on the next toggle.
	if [[ ${#fallback[@]} -gt 0 ]]; then
		set_origin "$current_id"
		exec "${fallback[@]}"
	fi
	set_origin ""
	exit 0
fi

if [[ $target_focused == "true" ]]; then
	# Already on the target: jump back to the origin window if it still exists,
	# else to the most recent visible window that is not a target (an origin
	# lost, or left on the target itself, must not turn the toggle into a no-op).
	origin_id="$(echo "$tree" | jq -r --arg m "$origin_mark" --arg p "$probe_mark" '
		[.. | objects | select(.type == "workspace" and .name != "__i3_scratch")
			| .. | objects | select(.type == "con" and .focused != true and ((.nodes // []) | length) == 0)
			| (.marks // [] | if type == "array" then . else [] end) as $marks
			| select($marks | index($p) | not)
			| {id, origin: ($marks | index($m) != null),
				sort: ([$marks[] | select(startswith("_dfzf-sort-")) | ltrimstr("_dfzf-sort-") | tonumber] | max // 0)}]
		| (map(select(.origin)) | first) // max_by(.sort) | .id // empty')"
	"$msg" -q "[con_mark=\"^${origin_mark}\$\"] unmark ${origin_mark}" >/dev/null 2>&1 || true

	if [[ -n $origin_id ]]; then
		"$msg" -q "[con_id=${origin_id}] focus" >/dev/null
	fi
	exit 0
fi

# Not on the target yet: mark the current window as origin, then jump to target.
set_origin "$current_id"
"$msg" -q "${criteria} focus" >/dev/null
