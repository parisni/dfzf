#!/usr/bin/env bash
set -euo pipefail

windows_app_id_map_json="{}"
windows_glyph_rules_json='[{"glyph": " "}]'
windows_title_rm_pattern="— Mozilla Firefox "
windows_app_filter="${DFZF_WINDOWS_APP_FILTER-}"
# kitty remote-control socket; kitty suffixes `listen_on` with its pid, hence the {pid} placeholder.
kitty_socket='/tmp/kitty-{pid}'
[ -f "$HOME/.config/dfzf/dfzf.conf" ] && source "$HOME/.config/dfzf/dfzf.conf"

# Parse command line options
input_json=""

# --show-hidden forces including dfzf-hidden windows for this invocation only,
# without touching the persistent /tmp/dfzf-windows-show-hidden state file.
force_show_hidden="${DFZF_WINDOWS_SHOW_HIDDEN-false}"
kitty_companions="${DFZF_WINDOWS_KITTY_COMPANIONS-false}"

while [[ $# -gt 0 ]]; do
	case $1 in
	--input-json)
		input_json="$2"
		shift 2
		;;
	--app)
		windows_app_filter="$2"
		shift 2
		;;
	--show-hidden)
		force_show_hidden=true
		shift
		;;
	--kitty-companions)
		kitty_companions=true
		shift
		;;
	*)
		shift
		;;
	esac
done

# Accept optional input via stdin or get tree if no input provided
if [ -z "$input_json" ]; then
	if [[ -z ${SWAYSOCK:-} && -z ${I3SOCK:-} && $OSTYPE == darwin* ]]; then
		# One request to the native backend, as in dfzf-windows.
		# shellcheck source=../macos/bin/dfzf-hs
		source "$(command -v dfzf-hs)"
		input_json="$(dfzf_hs '{"op":"tree"}')"
		[[ $input_json != *'{}'* ]] || input_json="$(dfzf-hs-msg -t get_tree)"
	else
		input_json="$(dfzf-exec -t get_tree --raw)"
	fi
fi

# `--input-json -` reads the tree from stdin. The tree can exceed the per-argument
# kernel limit (MAX_ARG_STRLEN, 128KiB), which made callers fail with
# "Argument list too long" once enough windows were open.
if [ "$input_json" = "-" ]; then
	input_json="$(</dev/stdin)"
fi

# kittyx companion shells live inside a kitty OS window, invisible to the WM:
# list them as pseudo windows of their host, matched by pid and exact title.
add_kitty_companions() {
	local tree="$1" pid socket kitty_json
	if ! command -v kitten >/dev/null; then
		printf '%s' "$tree"
		return
	fi
	for pid in $(jq -r '[.. | objects | select(.type == "con") | .pid // empty] | unique | .[]' <<<"$tree"); do
		socket="${kitty_socket//\{pid\}/$pid}"
		[[ -S $socket ]] || continue
		kitty_json=$(kitten @ --to "unix:$socket" ls 2>/dev/null) || continue
		tree=$(jq --argjson pid "$pid" --argjson kitty "$kitty_json" '
		  [.. | objects | select(.type == "con" and .pid == $pid)] as $hosts
		  | [ $kitty[]
		      | ([.tabs[] | select(.is_active) | .windows[] | select(.is_active) | .title][0]) as $os_title
		      | first($hosts[] | select(.name == $os_title)) as $host
		      | .tabs[].windows[] | select(.user_vars.kittyx_companion)
		      | (([$host.marks[]? | select(startswith("_dfzf-sort-"))] | first // "_dfzf-sort-0")
		          | ltrimstr("_dfzf-sort-") | tonumber | if . > 0 then . - 1 else 0 end) as $sort
		      | {type: "con", id: $host.id, name: ("↳ " + .title), app_id: $host.app_id,
		         window_properties: $host.window_properties, urgent: false,
		         marks: ["_dfzf-sort-\($sort)"], kitty_window: "\($pid).\(.id)"} ] as $companions
		  | .nodes += $companions' <<<"$tree")
	done
	printf '%s' "$tree"
}
if [[ $kitty_companions == true ]]; then
	input_json="$(add_kitty_companions "$input_json")"
fi

state_hidden_file="/tmp/dfzf-windows-show-hidden"
show_hidden=false
if [[ -f $state_hidden_file ]] || [[ $force_show_hidden == true ]]; then
	show_hidden=true
fi

RESET=$'\033[0m'
RED=$'\033[31m'
BLUE=$'\033[34m'
GREEN=$'\033[32m'
color_state_file=""
for state_file in /tmp/dfzf-windows-color-?*; do
	if [[ -f $state_file ]]; then
		color_state_file="$state_file"
		break
	fi
done
# Main processing logic, in a single jq pass: filtering, formatting, recency
# sort, title cleanup and the highlight of the first line. One process instead
# of a jq | sort | sed | perl pipeline: dfzf-windows lists on every popup.
# The sort is the former `sort -nr` on lines all prefixed by their sort mark:
# most recent first, ties by line, both descending.
result=$(
	jq -r --arg red "$RED" --arg blue "$BLUE" --arg green "$GREEN" --arg reset "$RESET" \
		--argjson map "$windows_app_id_map_json" \
		--argjson glyph_rules "$windows_glyph_rules_json" \
		--argjson show_hidden "$show_hidden" \
		--arg app_filter "$windows_app_filter" \
		--arg title_rm_pattern "$windows_title_rm_pattern" '
	  def format_title(text): "\u2063" + text + "\u2063";
	  # Wraps the uncolored chunks of the line in the highlight color, leaving
	  # the already colored \e[..m...\e[0m chunks as they are.
	  def highlight:
	    . as $line
	    | [match("\u001b\\[[0-9;]+m.*?\u001b\\[0m"; "g")] as $colored
	    | ($colored | length) as $count
	    | ([0] + [$colored[] | .offset + .length]) as $starts
	    | ([$colored[] | .offset] + [$line | length]) as $ends
	    | [range(0; $count + 1) as $i
	        | $line[$starts[$i]:$ends[$i]] as $chunk
	        | (if $i == $count and $chunk == "" then ""
	           else "\u001b[38;2;76;120;153m" + $chunk + "\u001b[0m" end)
	          + (if $i < $count then $colored[$i].string else "" end)]
	    | join("");
	  [
	    .. | objects
	    | select(.type == "con" or .type == "floating_con")
    | select(.window_type == null or .window_type == "normal")
    | select(.name != null)
    | select((.app_id // .window_properties.class) != null)
    | select((.app_id // .window_properties.class) != "dfzf-popup")
    | select($show_hidden or ((.app_id // .window_properties.class) != "dfzf-hidden"))
    | select((.app_id // .window_properties.class) != "dfzf-scratchpad")
    | select((.app_id // .window_properties.class) != "dfzf-git")
    | . as $win
    | {
        id: .id,
        kitty: .kitty_window,
        name: .name,
        sort: ([.marks[]? | select(startswith("_dfzf-sort"))] | first // "_dfzf-sort-0"),
        app_id: (
          (.app_id // .window_properties.class) as $app_id
          | ($map[$app_id] // $app_id)
        ),
        urgent: .urgent,
        red: (if any(.marks[]?; startswith("_dfzf-red-")) then "\($red) \($reset)" else "" end),
        blue: (if any(.marks[]?; startswith("_dfzf-blue-")) then "\($blue) \($reset)" else "" end),
        green: (if any(.marks[]?; startswith("_dfzf-green-")) then "\($green) \($reset)" else "" end),
        glyph: (
          ($glyph_rules
            | map(
                . as $rule |
                select(
                  ($rule.field == "app_id" and ($win.app_id // $win.window_properties.class // "" | test($rule.regex; "i"))) or
                  ($rule.field == "name"   and ($win.name // "" | test($rule.regex; "i"))) or
                  ($rule.field == null) # default glyph
                )
              )
            | first
            | .glyph
          )
	        )
	      }
	    | select($app_filter == "" or (.app_id | ascii_downcase) == ($app_filter | ascii_downcase))
	    | {
	        recency: (.sort | ltrimstr("_dfzf-sort-") | tonumber? // 0),
	        line: "\(if .urgent then "\u001b[33m" else "" end)\(.glyph) [\(.app_id)]\(if .urgent then "\u001b[0m" else "" end)\t\(.red)\(.blue)\(.green) \(format_title(.name)) #\(.id)\(if .kitty then " ~k\(.kitty)" else "" end)"
	      }
	  ]
	  | sort_by(.recency, .line) | reverse
	  | map(.line | sub($title_rm_pattern; ""))
	  | (if length > 0 then .[0] |= highlight else . end)
	  | .[]' <<<"$input_json"
)

if [[ -f $color_state_file ]]; then
	# Extract the color number from the filename
	color="${color_state_file##*-}" # removes everything before last dash
	color_code=$(printf "\033[%sm" "$color")
	rg -F $"$color_code" <<<"$result" || printf '%s\n' "$result"
else
	printf '%s\n' "$result"
fi
