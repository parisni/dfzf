#!/usr/bin/env bash
set -euo pipefail

# Spawned in its own kitty window by `dfzf-mail` (ctrl-f) so that $EDITOR runs
# in a regular tiled terminal, not in the dfzf-popup floating kitty (which has
# `map escape close_window` and a 65% size, both unsuitable for composing a
# forward).
#
# Usage: dfzf-mail-forward <mailbox> <id>
#
# himalaya v2 dropped the editor-driven composer: himalaya only fetches the
# source message, `dfzf-mail-compose` owns the template + $EDITOR + send loop.

mailbox="${1:?missing mailbox}"
id="${2:?missing id}"

source_eml="$(mktemp -t dfzf-mail-source-XXXXXX.eml)"
trap 'rm -f "$source_eml"' EXIT

himalaya --log off message read -m "$mailbox" --raw "$id" >"$source_eml"
dfzf-mail-compose forward -- "$source_eml"
