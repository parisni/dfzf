#!/usr/bin/env bash
set -euo pipefail

# Acts on one dfzf-windows line. Kitty companion lines (`~k<pid>.<window id>`)
# target that kitty window inside the host OS window given by `#<con_id>`.

kitty_socket='/tmp/kitty-{pid}'
[ -f "$HOME/.config/dfzf/dfzf.conf" ] && source "$HOME/.config/dfzf/dfzf.conf"

usage="usage: dfzf-windows-line focus|kill <line>"
action="${1:?$usage}"
line="${2-}"
# The last `#<digits>` of the line, matched bytewise like perl did: a title that
# is not valid UTF-8 must not defeat the match.
con_id=""
parse_con_id() {
	local LC_ALL=C re='.*#([0-9]+)'
	if [[ $line =~ $re ]]; then
		con_id="${BASH_REMATCH[1]}"
	fi
}
parse_con_id
[[ -n $con_id ]] || exit 0

# macOS: one request to the backend, without the dfzf-exec -> dfzf-hs-msg hops.
if [[ -z ${SWAYSOCK:-} && -z ${I3SOCK:-} && $OSTYPE == darwin* ]]; then
	# shellcheck source=../macos/bin/dfzf-hs
	source "$(command -v dfzf-hs)"
	focus_window() { dfzf_hs "{\"op\":\"focus\",\"id\":$1}" >/dev/null; }
else
	focus_window() { dfzf-exec -q "[con_id=$1] focus"; }
fi

kitty_args=()
re_kitty='~k([0-9]+)\.([0-9]+)'
if [[ $line =~ $re_kitty ]]; then
	kitty_args=(--to "unix:${kitty_socket//\{pid\}/${BASH_REMATCH[1]}}")
	kitty_match="id:${BASH_REMATCH[2]}"
fi

case "$action" in
focus)
	# Switch kitty to the companion first so the host OS window shows it.
	if [[ ${#kitty_args[@]} -gt 0 ]]; then
		kitten @ "${kitty_args[@]}" focus-window --match "$kitty_match"
	fi
	focus_window "$con_id"
	;;
kill)
	if [[ ${#kitty_args[@]} -gt 0 ]]; then
		kitten @ "${kitty_args[@]}" close-window --match "$kitty_match"
	else
		dfzf-windows-kill "$con_id"
	fi
	;;
*)
	echo "$usage" >&2
	exit 2
	;;
esac
