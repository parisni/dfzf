#!/usr/bin/env bash
set -euo pipefail

# No mako on macOS: a dedicated script reads Notification Center instead.
if [[ $(uname -s) == Darwin ]]; then
	exec dfzf-notifs-macos "$@"
fi

export SHELL="$(command -v bash)"
[[ $OSTYPE == darwin* ]] || dfzf-kill-bro >/dev/null
export FZF_DEFAULT_OPTS="--ansi --no-sort --exact --cycle --color=gutter:-1 --header= --info=inline-right ${DFZF_FZF_OPTS-"--padding=1,2 --border=rounded --color=border:#ff8800"}"
HIST_FLAG="/tmp/dfzf-notif_history_mode"
rm -f $HIST_FLAG

# mako >= 1.11 emits a flat JSON array (commit 322dece "makoctl: add JSON
# output for list and history"). Each entry has plain keys like .id, .summary,
# .body instead of the previous busctl typed JSON (.id.data, .summary.data...).
dfzf-notifs-load | jq -r '.[] | "\(.id):\(.summary)"' |
	fzf --prompt "Notifs > " --multi \
		--preview 'dfzf-notifs-load | jq -r --arg id "$(echo {} | perl -0777 -pe "s/:.*//s")" ".[] | select(.id == (\$id | tonumber)) | .body" ' \
		--preview-window=up:30%:wrap \
		--bind "enter:execute-silent(echo {}| perl -0777 -pe 's/:.*//s' | xargs makoctl invoke -n && (echo {}|grep -q 'Gmail ' || dfzf-exec -q '[title=\"Slack\"]' focus))+accept" \
		--bind "ctrl-k:execute-silent(echo {}| perl -0777 -pe 's/:.*//s' |xargs makoctl dismiss -n)+reload(dfzf-notifs-load | jq -r '.[] | \"\(.id):\(.summary)\"' )" \
		--bind "alt-K:select-all+execute-silent(for item in {+}; do makoctl dismiss -n \"\${item%%:*}\"; done)+deselect-all+reload(dfzf-notifs-load | jq -r '.[] | \"\(.id):\(.summary)\"' )" \
		--bind "ctrl-h:execute-silent(sh -c '[ -f \"$HIST_FLAG\" ] && rm -f \"$HIST_FLAG\" || touch \"$HIST_FLAG\"')+transform-prompt(sh -c '[ -f \"$HIST_FLAG\" ] && echo \"Notifs History > \" || echo \"Notifs > \"')+reload(dfzf-notifs-load  | jq -r '.[] | \"\(.id):\(.summary)\"')"
