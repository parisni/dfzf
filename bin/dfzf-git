#!/usr/bin/env bash
set -euo pipefail

# Default configuration
term_dir_regex='s/.*\[([^]]+)\].*|^(.+) - NVIM$|(.+) \/..$/\1\2\3/p'
# Extra lazygit CLI args (e.g. "status --screen-mode=full"); empty keeps lazygit's own default view.
lazygit_args=''
# kitty remote-control socket; kitty suffixes `listen_on` with its pid, hence the {pid} placeholder.
kitty_socket='/tmp/kitty-{pid}'
[ -f "$HOME/.config/dfzf/dfzf.conf" ] && source "$HOME/.config/dfzf/dfzf.conf"

# Find git repository root by searching for .git folder
find_git_root() {
	local dir="$1"

	# Handle tilde expansion
	dir="${dir/#\~/$HOME}"

	# Make sure we have an absolute path
	if [[ ! $dir =~ ^/ ]]; then
		dir="$PWD/$dir"
	fi

	# Search upward for .git directory
	while [[ $dir != "/" ]]; do
		if [[ -d "$dir/.git" ]]; then
			echo "$dir"
			return 0
		fi
		dir=$(dirname "$dir")
	done

	return 1
}

# Ask kitty for the active tab's cwd, since TUIs running inside it may overwrite the window title.
kitty_cwd() {
	local pid="$1" class="$2"
	local socket="${kitty_socket//\{pid\}/$pid}"
	[[ -n $pid && -S $socket ]] && command -v kitty >/dev/null || return 1
	kitty @ --to "unix:$socket" ls 2>/dev/null | jq -r --arg class "$class" '
		[.[] | select($class == "" or .wm_class == $class)]
		| (map(select(.is_focused)) + map(select(.last_focused)) + .)[0] // empty
		| .tabs[] | select(.is_active) | .windows[] | select(.is_active) | .cwd // empty
	'
}

# Get terminal command from args or use default.
#
# NOTE: dfzf-git uses $DFZF_TERM *without* the `-e` flag (unlike dfzf-mail
# and dfzf-launcher which include it). That's because dfzf-git needs to
# inject `--app-id`/`--class` and `-d <dir>` before the `-e` flag, which
# would not be possible if `-e` were already at the tail of the variable.
# Pragmatic compromise: keep `-e lazygit` hardcoded below; let users
# override DFZF_TERM with just "kitty -1" / "alacritty" / "foot", etc.
term_cmd="${*:1}"
term_cmd="${term_cmd:-${DFZF_TERM:-kitty -1}}"

focused_window=$(dfzf-exec -t get_tree | jq -c '[.. | objects | select(.focused == true)][0] // {}')
focused_window_name=$(jq -r '.name // empty' <<<"$focused_window")
focused_window_pid=$(jq -r '.pid // empty' <<<"$focused_window")
focused_window_class=$(jq -r '.app_id // .window_properties.class // empty' <<<"$focused_window")

extracted_dir=$(kitty_cwd "$focused_window_pid" "$focused_window_class" || true)

# Fall back to extracting the directory from the focused window name
if [[ -z $extracted_dir && -n $focused_window_name ]]; then
	extracted_dir=$(echo "$focused_window_name" | sed -n -E "$term_dir_regex")
fi

# If no directory extracted from focused window, try other windows in workspace
if [[ -z $extracted_dir ]]; then
	while IFS= read -r window_name; do
		if [[ -n $window_name ]]; then
			dir=$(echo "$window_name" | sed -n -E "$term_dir_regex")
			if [[ -n $dir ]]; then
				extracted_dir="$dir"
				break
			fi
		fi
	done < <(dfzf-exec -t get_tree | jq -r '.nodes[] | recurse(.nodes[]?) | select(.type == "con") | select(.name) | .name')
fi

# Detect sway vs i3 and use appropriate selector
if [[ -n ${SWAYSOCK:-} ]]; then
	selector='app_id="dfzf-git"'
	create_args="--app-id dfzf-git"
elif [[ -n ${I3SOCK:-} ]]; then
	selector='class="dfzf-git"'
	create_args="--class dfzf-git"
else
	echo "No running instance of Sway or i3 detected."
	exit 1
fi

# Check if dfzf-git window exists and get its workspace
workspace=$(dfzf-exec -t get_tree | jq -r '
	[.. | objects | select(.type == "workspace")] | 
	map(select([.. | objects | select((.app_id // .window_properties.class) == "dfzf-git")] | length > 0)) | 
	.[0].name // empty
')

if [[ -z $workspace ]]; then
	# No dfzf-git window exists, create new one
	# Try to find git root from extracted directory, fallback to current directory
	git_root=""
	if [[ -n $extracted_dir ]]; then
		git_root=$(find_git_root "$extracted_dir")
	fi
	if [[ -z $git_root ]]; then
		git_root=$(git rev-parse --show-toplevel 2>/dev/null)
	fi

	# Create new terminal window
	if [[ -n $git_root ]]; then
		dfzf-exec -q "exec ${DFZF_TERM:-kitty -1} $create_args -d \"$git_root\" -e lazygit $lazygit_args"
	else
		dfzf-exec -q "exec ${DFZF_TERM:-kitty -1} $create_args -e lazygit $lazygit_args"
	fi
	sleep 0.2
	dfzf-exec -q "[$selector] move scratchpad, scratchpad show"
	dfzf-resize 90
else
	# Window exists, check workspace
	if [[ $workspace == "__i3_scratch" ]]; then
		# Window is in scratchpad, show it
		dfzf-exec -q "[$selector] scratchpad show"
		dfzf-resize 90
	else
		# Window is visible, move it to scratchpad
		dfzf-exec -q "[$selector] move scratchpad"
	fi
fi
