#!/usr/bin/env bash
set -euo pipefail

export SHELL="$(command -v bash)"
[[ $OSTYPE == darwin* ]] || dfzf-kill-bro >/dev/null
export FZF_DEFAULT_OPTS="--ansi --no-sort --exact --cycle --color=gutter:-1 --header= --info=inline-right ${DFZF_FZF_OPTS-"--padding=1,2 --border=rounded --color=border:#ff8800"}"

pass_list_store() {
	local fd_cmd
	if command -v fd >/dev/null; then
		fd_cmd="fd"
	elif command -v fdfind >/dev/null; then
		fd_cmd="fdfind"
	else
		echo "Neither fd nor fdfind found. Please install one of them." >&2
		exit 1
	fi
	"$fd_cmd" -e gpg -d 8 -t f --base-directory "${PASSWORD_STORE_DIR:-$HOME/.password-store}" |
		sed 's|\.gpg$||'
}

if command -v copyq &>/dev/null; then
	export password_clip_cmd="tee >(copyq add -) | copyq copy -"
elif [[ -n ${WAYLAND_DISPLAY-} ]] && command -v wl-copy &>/dev/null; then
	export password_clip_cmd="wl-copy"
elif [[ -n ${DISPLAY-} ]]; then
	if command -v xclip &>/dev/null; then
		export password_clip_cmd="xclip -selection clipboard"
	elif command -v xsel &>/dev/null; then
		export password_clip_cmd="xsel --clipboard --input"
	else
		echo "No clipboard utility (xclip/xsel/wl-copy) found." >&2
		exit 1
	fi
else
	echo "Neither DISPLAY nor WAYLAND_DISPLAY is set. Clipboard not available." >&2
	exit 1
fi
# gopass first: only gopass knows its mounts, which a walk of one store directory misses.
if command -v gopass >/dev/null; then
	[ -z "${pass_list_cmd+x}" ] && export pass_list_cmd="gopass ls --flat"
	[ -z "${pass_preview_cmd+x}" ] && export pass_preview_cmd="gopass show --nosync"
	[ -z "${pass_show_password_cmd+x}" ] && export pass_show_password_cmd="gopass show --nosync -o"
	[ -z "${pass_otp_cmd+x}" ] && export pass_otp_cmd="gopass otp -o"
else
	[ -z "${pass_list_cmd+x}" ] && export pass_list_cmd="pass_list_store"
	[ -z "${pass_preview_cmd+x}" ] && export pass_preview_cmd="pass show"
	[ -z "${pass_show_password_cmd+x}" ] && export pass_show_password_cmd="pass show"
	[ -z "${pass_otp_cmd+x}" ] && export pass_otp_cmd="pass otp"
fi
[ -f "$HOME/.config/dfzf/dfzf.conf" ] && source "$HOME/.config/dfzf/dfzf.conf"

# Start with the keybinding cheatsheet hidden each session (`?` toggles it).
dfzf-help reset password

eval "$pass_list_cmd" |
	fzf --prompt "Password > " \
		--bind="?:transform-header(dfzf-help toggle password)" \
		--delimiter "/" --with-nth 1.. \
		--preview="$pass_preview_cmd {}" \
		--preview-window=hidden:right:wrap \
		--bind 'ctrl-j:toggle-preview' \
		--bind="enter:execute-silent($pass_show_password_cmd {} | head -n1 | $password_clip_cmd)+accept" \
		--bind="ctrl-o:execute-silent($pass_otp_cmd {} | head -n1 | $password_clip_cmd)+accept"
